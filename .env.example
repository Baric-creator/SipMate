# Client-side Expo variables. EXPO_PUBLIC_* values are embedded in the app bundle.
# Never put service-role keys, Stripe secret keys, webhook secrets,
# Google service-account credentials, or any other server-only secret here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
